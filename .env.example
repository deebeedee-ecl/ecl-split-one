# ECL Split One environment template
#
# Copy this file to .env.local for the Next.js app and replace only the values
# needed for your work. Never commit real credentials, tokens, cookies, or URLs
# containing credentials.

# Core web application -------------------------------------------------------

# PostgreSQL connection used by Prisma.
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DATABASE?schema=public"

# Public Supabase project configuration. Never use a service-role/secret key.
NEXT_PUBLIC_SUPABASE_URL="https://YOUR_PROJECT.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="YOUR_PUBLIC_ANON_OR_PUBLISHABLE_KEY"

# Safe local URLs. Change these in deployed environments.
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
ECL_SITE_URL="http://localhost:3000"

# Admin access ---------------------------------------------------------------
# Uncomment only after replacing every placeholder with an independent value.
# Keep these variables server-only.

# ADMIN_USERNAME="CHOOSE_A_USERNAME"
# ADMIN_PASSWORD="GENERATE_A_LONG_RANDOM_PASSWORD"
# ADMIN_SESSION_SECRET="GENERATE_A_DIFFERENT_LONG_RANDOM_SECRET"

# Service-to-service authentication -----------------------------------------
# Generate independent random values. Services that communicate with each
# other must use the matching value.

ECL_KOOK_BOT_SECRET=
ECL_JOB_SECRET=
ECL_REPORT_ENGINE_SECRET=

# KOOK integration -----------------------------------------------------------

KOOK_BOT_TOKEN=
KOOK_ADMIN_CHANNEL_ID=
KOOK_SPLIT_II_CHANNEL_ID=
KOOK_RANKED_INHOUSE_CATEGORY_ID=
KOOK_RANKED_INHOUSE_CHANNEL_ID=
KOOK_BLUE_SIDE_CHANNEL_ID=
KOOK_RED_SIDE_CHANNEL_ID=

# Web match lookup and inhouse reporting ------------------------------------

LZYUMI_BASE_URL=
LZYUMI_SECRET=
INHOUSE_REPORT_REQUIRED_MATCHES=8
INHOUSE_REPORT_CANDIDATE_LIMIT=24
INHOUSE_REPORT_LZYUMI_ALL_COUNT=20
INHOUSE_REPORT_EARLY_GRACE_MINUTES=10
INHOUSE_REPORT_LATE_WINDOW_HOURS=6

# Optional complete ranked-season override. Uncomment all three together;
# partial overrides intentionally fail closed.
# ECL_RANKED_SEASON_ID="ranked-season-id"
# ECL_RANKED_SEASON_NAME="Ranked Season Name"
# ECL_RANKED_SEASON_START="YYYY-MM-DDTHH:mm:ss.sssZ"

# Desktop update hosting -----------------------------------------------------

ECL_DESKTOP_UPDATE_BLOB_BASE=
# Absolute path to the public verification key for trusted release builds.
ECL_UPDATE_PUBLIC_KEY_FILE=

# Report engine --------------------------------------------------------------
# The worker reads root .env and report-engine/.env, not root .env.local.

REPORT_ENGINE_WORKER_ID="ecl-report-engine-local"
REPORT_ENGINE_POLL_MS=5000
REPORT_ENGINE_MATCH_SOURCE="lzyumi"
REPORT_ENGINE_FETCH_MODE="browser"
REPORT_ENGINE_REQUIRED_MATCHES=8
REPORT_ENGINE_CANDIDATE_LIMIT=24
REPORT_ENGINE_EARLY_GRACE_MINUTES=10
REPORT_ENGINE_LATE_WINDOW_HOURS=6

# Lzyumi source. Credentials/tokens are secrets.
REPORT_ENGINE_LZYUMI_BASE="https://l.lzyumi.top/lzyumi/lol"
REPORT_ENGINE_LZYUMI_REFERER="https://l.lzyumi.top/vippc.html"
REPORT_ENGINE_LZYUMI_LOGIN_URL=
REPORT_ENGINE_LZYUMI_LOGIN_ID=
REPORT_ENGINE_LZYUMI_LOGIN_PASSWORD=
REPORT_ENGINE_LZYUMI_LOGIN_TARGET="PC"
REPORT_ENGINE_LZYUMI_TOKENSTR=
REPORT_ENGINE_LZYUMI_PROFILE_DIR=
REPORT_ENGINE_LZYUMI_TIMEOUT_MS=15000
REPORT_ENGINE_LZYUMI_WARMUP_MS=2500
REPORT_ENGINE_LZYUMI_HEADLESS=true
REPORT_ENGINE_LZYUMI_ALL_COUNT=10
REPORT_ENGINE_LZYUMI_HISTORY_CONCURRENCY=2
REPORT_ENGINE_LZYUMI_PLAYER_CONCURRENCY=1
REPORT_ENGINE_LZYUMI_DETAIL_CONCURRENCY=2
REPORT_ENGINE_LZYUMI_CODE_7_RETRIES=2
REPORT_ENGINE_LZYUMI_CODE_7_BACKOFF_MS=1000
REPORT_ENGINE_DEBUG_LZYUMI=false
REPORT_ENGINE_BROWSER_EXECUTABLE_PATH=

# WeGame source. The cookie and related authentication values are secrets.
REPORT_ENGINE_WEGAME_BASE=
REPORT_ENGINE_WEGAME_LOGIN_BY_QQ_URL=
REPORT_ENGINE_WEGAME_COOKIE=
REPORT_ENGINE_WEGAME_AUTH_MODE="auto"
REPORT_ENGINE_WEGAME_TIMEOUT_MS=15000
REPORT_ENGINE_WEGAME_REFRESH_MARGIN_SECONDS=60
REPORT_ENGINE_WEGAME_LIST_COUNT=8
REPORT_ENGINE_DEBUG_WEGAME=false

# Optional outbound proxy. Username and password are secrets.
REPORT_ENGINE_PROXY_URL=
REPORT_ENGINE_PROXY_SERVER=
REPORT_ENGINE_PROXY_USERNAME=
REPORT_ENGINE_PROXY_PASSWORD=
