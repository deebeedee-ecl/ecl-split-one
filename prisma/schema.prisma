generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id        String   @id @default(uuid())
  email     String   @unique
  createdAt DateTime @default(now())

  profile AccountProfile?
}

model AccountProfile {
  id                  String              @id @default(uuid())
  userId              String              @unique
  user                User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  displayName         String
  email               String
  riotName            String
  riotTag             String
  chinaServerId       Int?
  chinaServerName     String?
  openId              String?
  lzyumiVerifiedAt    DateTime?
  lzyumiLastLookupAt  DateTime?
  lzyumiRawProfile    Json?
  lzyumiRecentStat    Json?
  lzyumiRankedGames   Json?
  kookUsername        String
  kookId              String?
  wechatId            String?
  primaryRole         String
  secondaryRole       String?
  currentRank         String?
  nationality         String?
  timezone            String?
  bio                 String?
  avatarStyle         String              @default("crest")
  avatarUrl           String?
  bannerUrl           String?
  dashboardTheme      String              @default("crimson")
  championPool        Json?
  privacySettings     Json?
  verificationStatus  VerificationStatus  @default(PENDING_KOOK)
  accountStatus       AccountStatus       @default(PENDING)
  createdAt           DateTime            @default(now())
  updatedAt           DateTime            @updatedAt
  kookVerifications   KookVerification[]

  @@index([email])
  @@index([riotName, riotTag])
  @@index([chinaServerId, riotName, riotTag])
  @@index([openId])
  @@index([kookUsername])
  @@index([verificationStatus])
  @@index([accountStatus])
}

model KookVerification {
  id          String                 @id @default(uuid())
  profileId   String
  profile     AccountProfile         @relation(fields: [profileId], references: [id], onDelete: Cascade)
  code        String                 @unique
  status      KookVerificationStatus @default(PENDING)
  kookUserId  String?
  confirmedAt DateTime?
  expiresAt   DateTime
  createdAt   DateTime               @default(now())
  updatedAt   DateTime               @updatedAt

  @@index([profileId])
  @@index([code])
  @@index([status])
}

model Team {
  id               String                  @id @default(uuid())
  name             String                  @unique
  logoUrl          String?
  kitUrl           String?
  createdAt        DateTime                @default(now())
  players          Player[]
  homeMatches      Match[]                 @relation("HomeTeamMatches")
  awayMatches      Match[]                 @relation("AwayTeamMatches")
  wonMatches       Match[]                 @relation("WinnerTeamMatches")
  signedFreeAgents FreeAgentRegistration[] @relation("SignedFreeAgents")
  wonGames         MatchGame[]             @relation("WinnerTeamGames")
  playerStats      MatchGamePlayerStat[]
}

model Player {
  id         String   @id @default(uuid())
  name       String
  riotName   String?
  riotTag    String?
  email      String?
  teamId     String?
  team       Team?    @relation(fields: [teamId], references: [id])
  elo        Int      @default(800)
  winStreak  Int      @default(0)
  lossStreak Int      @default(0)
  createdAt  DateTime @default(now())

  gameStats MatchGamePlayerStat[]

  @@index([teamId])
  @@index([riotName, riotTag])
}

model FreeAgentRegistration {
  id               String   @id @default(uuid())
  playerName       String
  email            String
  riotName         String
  riotTag          String
  primaryRole      String
  secondaryRole    String?
  currentRank      String?
  notes            String?
  status           String   @default("pending")
  signedToTeamId   String?
  signedToTeamName String?
  submittedAt      DateTime @default(now())

  signedToTeam Team? @relation("SignedFreeAgents", fields: [signedToTeamId], references: [id])
}

model TeamRegistration {
  id           String   @id @default(uuid())
  teamName     String
  captainName  String
  captainEmail String
  players      Json
  status       String   @default("pending")
  submittedAt  DateTime @default(now())
}

model LeagueWireItem {
  id        String   @id @default(uuid())
  text      String
  href      String?
  isVisible Boolean  @default(true)
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model ContactMessage {
  id        String   @id @default(uuid())
  name      String
  contact   String
  topic     String
  message   String
  status    String   @default("new")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
  @@index([createdAt])
}

model Match {
  id          String      @id @default(uuid())
  stage       MatchStage
  roundLabel  String?
  matchLabel  String?
  bestOf      Int
  scheduledAt DateTime?
  status      MatchStatus @default(SCHEDULED)

  homeTeamId   String
  awayTeamId   String
  winnerTeamId String?

  homeScore Int @default(0)
  awayScore Int @default(0)

  forfeitWinnerId String?
  notes           String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  homeTeam   Team        @relation("HomeTeamMatches", fields: [homeTeamId], references: [id])
  awayTeam   Team        @relation("AwayTeamMatches", fields: [awayTeamId], references: [id])
  winnerTeam Team?       @relation("WinnerTeamMatches", fields: [winnerTeamId], references: [id])
  games      MatchGame[]

  @@index([stage])
  @@index([status])
  @@index([scheduledAt])
  @@index([homeTeamId])
  @@index([awayTeamId])
}

model MatchGame {
  id              String   @id @default(uuid())
  matchId         String
  gameNumber      Int
  winnerTeamId    String?
  durationSeconds Int?
  homeKills       Int?
  awayKills       Int?
  homeGold        Int?
  awayGold        Int?

  homeTowers      Int?
  awayTowers      Int?

  homeInhibitors  Int?
  awayInhibitors  Int?

  homeBarons      Int?
  awayBarons      Int?

  homeDrakes      Int?
  awayDrakes      Int?

  mvpName         String?
  notes           String?
  ocrRawJson      Json?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  match       Match                @relation(fields: [matchId], references: [id], onDelete: Cascade)
  winnerTeam  Team?                @relation("WinnerTeamGames", fields: [winnerTeamId], references: [id])
  playerStats MatchGamePlayerStat[]

  @@unique([matchId, gameNumber])
  @@index([matchId])
  @@index([winnerTeamId])
}

model MatchGamePlayerStat {
  id           String   @id @default(uuid())
  matchGameId  String
  playerId     String
  teamId       String?

  riotName     String?
  riotTag      String?

  kills        Int @default(0)
  deaths       Int @default(0)
  assists      Int @default(0)

  gold         Int?
  damage       Int?
  cs           Int?
  visionScore  Int?

  isWin        Boolean @default(false)
  isMVP        Boolean @default(false)
  isSVP        Boolean @default(false)

  lpChange     Int      @default(0)
  eloBefore    Int?
  eloAfter     Int?

  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  matchGame    MatchGame @relation(fields: [matchGameId], references: [id], onDelete: Cascade)
  player       Player    @relation(fields: [playerId], references: [id], onDelete: Cascade)
  team         Team?     @relation(fields: [teamId], references: [id])

  @@unique([matchGameId, playerId])
  @@index([matchGameId])
  @@index([playerId])
  @@index([teamId])
  @@index([isWin])
  @@index([isMVP])
}

model InhouseSession {
  id               String                 @id @default(uuid())
  status           String                 @default("ASSIGNED")
  sourceChannelId  String
  blueChannelId    String
  redChannelId     String
  blueTeamId       String?
  redTeamId        String?
  matchId          String?
  matchGameId      String?
  lzyumiGameId     String?                @unique
  reportedByKookId String?
  reportRawJson    Json?
  createdAt        DateTime               @default(now())
  completedAt      DateTime?
  updatedAt        DateTime               @updatedAt
  players          InhouseSessionPlayer[]

  @@index([status])
  @@index([createdAt])
  @@index([reportedByKookId])
}

model InhouseSessionPlayer {
  id          String   @id @default(uuid())
  sessionId   String
  kookUserId  String
  profileId   String?
  playerId    String?
  displayName String
  riotName    String?
  riotTag     String?
  email       String?
  side        String
  eloAtReady  Int
  createdAt   DateTime @default(now())

  session InhouseSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@unique([sessionId, kookUserId])
  @@index([sessionId])
  @@index([kookUserId])
  @@index([playerId])
}

enum MatchStage {
  REGULAR_SEASON
  PLAYOFFS
  SEMIFINALS
  FINALS
}

enum MatchStatus {
  SCHEDULED
  COMPLETED
  FORFEIT
  POSTPONED
  CANCELLED
}

enum VerificationStatus {
  PENDING_KOOK
  VERIFIED
  REJECTED
}

enum AccountStatus {
  PENDING
  ACTIVE
  SUSPENDED
}

enum KookVerificationStatus {
  PENDING
  CONFIRMED
  EXPIRED
}
